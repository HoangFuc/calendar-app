<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <View
        android:id="@+id/blue_bar"
        android:layout_width="4dp"
        android:layout_height="18dp"
        android:background="#4A3AFF"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/blue_bar"
        android:layout_marginStart="8dp"
        android:text="Timeline"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:text="UP NEXT"
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/event_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_title"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <!-- Dynamic items will go here or static placeholders for now -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            
            <TextView
                android:id="@+id/event_time_1"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="10:00 AM"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/event_time_1"
                android:orientation="vertical">
                
                <TextView
                    android:id="@+id/event_title_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Product Strategy Sync"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="15sp" />
                
                <TextView
                    android:id="@+id/event_location_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Design Studio"
                    android:textColor="#99FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>
